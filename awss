#!/usr/bin/env bash

set -euo pipefail

AWS_CONFIG="${HOME}/.aws/config"

# Check that fzf is installed
if ! command -v fzf >/dev/null 2>&1; then
  echo "Error: fzf is not installed."
  exit 1
fi

# Check if aws is installed
if ! command -v aws >/dev/null 2>&1; then
  echo "❌ aws is not installed."
  echo "   Please install aws and try again."
  exit 1
fi

# Check that AWS config exists
if [[ ! -f "$AWS_CONFIG" ]]; then
  echo "Error: $AWS_CONFIG not found."
  exit 1
fi

get_profiles() {
  grep '^\[profile ' "$AWS_CONFIG" |
    sed -E 's/^\[profile (.*)\]$/\1/' |
    sort -u
}

case "${1:-}" in
-h | --help)
  cat <<EOF
Usage: $(basename "$0") [OPTION]

Select an AWS profile from ~/.aws/config using fzf.

Options:
  -l, --list    List AWS profiles
  -h, --help    Show this help message

Examples:
  $(basename "$0")
  $(basename "$0") -l
  $(basename "$0") --list

EOF
  exit 0
  ;;
-l | --list)
  get_profiles
  exit 0
  ;;
"")
  ;;
*)
  echo "Error: Unknown option '$1'"
  echo "Try '$(basename "$0") --help'"
  exit 1
  ;;
esac

PROFILE=$(
  get_profiles |
    fzf \
      --height=40% \
      --reverse \
      --prompt="AWS Profile > " \
      --border \
      --bind='j:down,k:up'
)

[[ -z "${PROFILE:-}" ]] && exit 0

echo "Selected profile: $PROFILE"

export AWS_PROFILE="$PROFILE"

aws sso login --profile "$PROFILE"

exec "${SHELL:-/bin/bash}"
